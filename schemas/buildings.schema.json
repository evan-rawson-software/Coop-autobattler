{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "buildings.schema.json",
  "title": "Building rules",
  "description": "Rules for every building (CB-9, CB-26c, CB-26d). All numbers are integers; times are in ticks. Sides describe rotation 0. A building has three tiers (the same building with better numbers); the core has exactly one set of numbers and is not bought. No display text: names live in the presentation file. Cross-file references (resource IDs, unit IDs) and layout rules are checked by the core loader.",
  "type": "object",
  "required": ["buildings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/building" }
    }
  },
  "$defs": {
    "side": { "enum": ["north", "east", "south", "west"] },
    "positive": { "type": "integer", "minimum": 1 },
    "nonNegative": { "type": "integer", "minimum": 0 },
    "health": {
      "description": "Building health. At most 1000000000000 (MAX_HEALTH in the core): the breach field sums building health along routes and must stay exact (docs/rules-reference.md, \"Content bounds\").",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "damage": {
      "description": "Damage per shot. At most 1000000000000 (MAX_DAMAGE in the core), the same bound as health.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "input": {
      "description": "A side that accepts a resource. 'resource' is required on buildings that consume a specific resource and absent on route buildings, which carry whatever they are fed (CB-5b).",
      "type": "object",
      "required": ["side"],
      "additionalProperties": false,
      "properties": {
        "side": { "$ref": "#/$defs/side" },
        "resource": { "type": "string", "pattern": "^res_[a-z0-9_]+$" }
      }
    },
    "tierBase": {
      "type": "object",
      "required": ["health", "price"],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "tierSource": {
      "type": "object",
      "required": ["health", "price", "intervalTicks"],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "intervalTicks": { "$ref": "#/$defs/positive" }
      }
    },
    "tierUnitProducer": {
      "description": "Exactly one of costPerUnit (one cost for every resource the building takes, counted alike) and costs (a cost per resource, CB-5e; the core loader checks that every resource in costs is the resource of an input and every input resource is in costs).",
      "type": "object",
      "required": ["health", "price", "productionIntervalTicks"],
      "oneOf": [
        { "required": ["costPerUnit"], "properties": { "costPerUnit": true } },
        { "required": ["costs"], "properties": { "costs": true } }
      ],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "costPerUnit": { "$ref": "#/$defs/positive" },
        "costs": {
          "description": "Resource units of each resource consumed to spawn one unit. Each at most 1000000 (MAX_TIER_COST in the core).",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4,
          "propertyNames": { "pattern": "^res_[a-z0-9_]+$" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "productionIntervalTicks": {
          "description": "Minimum ticks between two units made by this producer (PP-6).",
          "$ref": "#/$defs/positive"
        },
        "unitsPerProduction": {
          "description": "Units spawned by one production (CB-13a); absent means 1. One production costs costPerUnit (or each of costs) times this.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "tierTurret": {
      "type": "object",
      "required": [
        "health",
        "price",
        "damage",
        "rangeCells",
        "cooldownTicks",
        "costPerShot"
      ],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "damage": { "$ref": "#/$defs/damage" },
        "rangeCells": { "$ref": "#/$defs/positive" },
        "cooldownTicks": { "$ref": "#/$defs/positive" },
        "costPerShot": { "$ref": "#/$defs/positive" },
        "minRangeCells": {
          "description": "Blind spot (CB-18b): the turret ignores a unit whose centre is closer than this many cells to its nearest cell. Absent: none. The core loader checks it is below rangeCells.",
          "$ref": "#/$defs/positive"
        },
        "splashPercent": {
          "description": "Splash (CB-18b): percent of the shot that every other enemy unit near the target takes, at least 1. Given together with splashRadiusCells, or not at all.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "splashRadiusCells": {
          "description": "Splash radius in cells from the target's centre (CB-18b); at most 2 (MAX_SPLASH_RADIUS_CELLS in the core).",
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "dependentRequired": {
        "splashPercent": ["splashRadiusCells"],
        "splashRadiusCells": ["splashPercent"]
      }
    },
    "tierWard": {
      "description": "The Rune Ward (CB-53): reflectDamage is returned to an enemy unit that hits a wall or gate of the owner next to the Ward (before armor); costPerStrike resource units are consumed per strike.",
      "type": "object",
      "required": ["health", "price", "reflectDamage", "costPerStrike"],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "reflectDamage": { "$ref": "#/$defs/damage" },
        "costPerStrike": { "$ref": "#/$defs/positive" }
      }
    },
    "tierEconomy": {
      "type": "object",
      "required": [
        "health",
        "price",
        "costPerStep",
        "stepPercent",
        "maxSteps",
        "stepIntervalTicks"
      ],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "costPerStep": { "$ref": "#/$defs/positive" },
        "stepIntervalTicks": {
          "description": "Minimum ticks between two upgrade steps of this building (PP-6).",
          "$ref": "#/$defs/positive"
        },
        "stepPercent": { "$ref": "#/$defs/positive" },
        "maxSteps": {
          "description": "The cap on upgrade steps (SC-8): every in-battle economy effect is capped.",
          "$ref": "#/$defs/positive"
        }
      }
    },
    "tierRefinery": {
      "description": "A refinery tier (CB-5d): items of each input resource consumed per batch, the time between batches and the items one batch makes. The core loader checks that costs names exactly the resources of the inputs.",
      "type": "object",
      "required": [
        "health",
        "price",
        "costs",
        "productionIntervalTicks",
        "outputPerBatch"
      ],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" },
        "price": { "$ref": "#/$defs/nonNegative" },
        "costs": {
          "description": "Resource units of each input resource consumed per batch. Each at most 1000000 (MAX_TIER_COST in the core).",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2,
          "propertyNames": { "pattern": "^res_[a-z0-9_]+$" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "productionIntervalTicks": {
          "description": "Minimum ticks between two batches.",
          "$ref": "#/$defs/positive"
        },
        "outputPerBatch": {
          "description": "Items of the output resource one batch makes. At most 1000 (MAX_OUTPUT_PER_BATCH in the core).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "tierCore": {
      "description": "The core is not bought, so it has no price.",
      "type": "object",
      "required": ["health"],
      "additionalProperties": false,
      "properties": {
        "health": { "$ref": "#/$defs/health" }
      }
    },
    "building": {
      "type": "object",
      "required": ["id", "kind", "footprint", "tiers", "inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^bld_[a-z0-9_]+$" },
        "kind": {
          "description": "CB-9. A refinery (CB-5d) takes one or two resources and puts a refined resource on its output conduit.",
          "enum": [
            "source",
            "route",
            "unit_producer",
            "defense",
            "economy",
            "refinery",
            "core"
          ]
        },
        "footprint": {
          "description": "Width and height in cells at rotation 0. `cells` (optional) lists the covered cells as [x, y] pairs inside the box (y up, as on the board); omitted means every cell of the box. It must be non-empty, without duplicates, 4-connected, and use every row and column of the box (the loader checks this).",
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "$ref": "#/$defs/positive" },
            "height": { "$ref": "#/$defs/positive" },
            "cells": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "tiers": { "type": "array" },
        "inputs": {
          "description": "Sides that accept a resource at rotation 0. More than one is allowed (CB-5a).",
          "type": "array",
          "items": { "$ref": "#/$defs/input" }
        },
        "outputs": {
          "description": "Sides that emit at rotation 0.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/side" }
        },
        "routeType": {
          "enum": ["splitter", "merger", "crossover", "tunnel_in", "tunnel_out"]
        },
        "partner": {
          "description": "Tunnel entrance only (CB-9g): the exit building bought with it. The core loader checks it is a tunnel exit named by one entrance only, and that the entrance's price is the exit's or one more.",
          "type": "string",
          "pattern": "^bld_[a-z0-9_]+$"
        },
        "maxSpanCells": {
          "description": "Tunnel entrance only (CB-9g): the most cells between the two ends, the same at every tier (MAX_TUNNEL_SPAN_CELLS in the core).",
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "resourceSetting": {
          "description": "Collector only (issue #473): its owner chooses one base resource when placing it and may change it between battles. A collector with the setting stands on any open cell of its owner's plot (no node needed) and makes the resource of its setting. Absent: an ordinary collector on a node.",
          "const": true
        },
        "unit": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
        "output": {
          "description": "Refinery only: the refined resource it makes. Its refinedFrom must be, as a set, the resources of the building's inputs (the core loader checks this).",
          "type": "string",
          "pattern": "^res_[a-z0-9_]+$"
        },
        "defenseType": { "enum": ["wall", "gate", "turret", "pylon", "ward"] },
        "effect": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["source_speed", "unit_strength"] }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "source" } },
            "required": ["kind"]
          },
          "then": true,
          "else": { "properties": { "resourceSetting": false } }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "source" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "properties": {
              "outputs": {
                "description": "A collector has exactly one output side (PP-5, CB-9e).",
                "type": "array",
                "minItems": 1,
                "maxItems": 1
              },
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierSource" }
              },
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "unit": false,
              "output": false,
              "defenseType": false,
              "effect": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "route" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "required": ["routeType"],
            "properties": {
              "routeType": true,
              "partner": true,
              "maxSpanCells": true,
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierBase" }
              },
              "unit": false,
              "output": false,
              "defenseType": false,
              "effect": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "routeType": { "const": "tunnel_in" } },
            "required": ["routeType"]
          },
          "then": { "required": ["partner", "maxSpanCells"] },
          "else": {
            "properties": { "partner": false, "maxSpanCells": false }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "unit_producer" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "required": ["unit"],
            "properties": {
              "unit": true,
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierUnitProducer" }
              },
              "output": false,
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "defenseType": false,
              "effect": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "defense" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "required": ["defenseType"],
            "properties": {
              "defenseType": true,
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "unit": false,
              "output": false,
              "effect": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": { "const": "defense" },
              "defenseType": { "const": "turret" }
            },
            "required": ["kind", "defenseType"]
          },
          "then": {
            "type": "object",
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierTurret" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": { "const": "defense" },
              "defenseType": { "const": "ward" }
            },
            "required": ["kind", "defenseType"]
          },
          "then": {
            "type": "object",
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierWard" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": { "const": "defense" },
              "defenseType": { "enum": ["wall", "gate", "pylon"] }
            },
            "required": ["kind", "defenseType"]
          },
          "then": {
            "type": "object",
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierBase" }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "economy" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "required": ["effect"],
            "properties": {
              "effect": true,
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierEconomy" }
              },
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "unit": false,
              "output": false,
              "defenseType": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "refinery" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "required": ["output"],
            "properties": {
              "output": true,
              "tiers": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/$defs/tierRefinery" }
              },
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "unit": false,
              "defenseType": false,
              "effect": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "kind": { "const": "core" } },
            "required": ["kind"]
          },
          "then": {
            "type": "object",
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": { "$ref": "#/$defs/tierCore" }
              },
              "routeType": false,
              "partner": false,
              "maxSpanCells": false,
              "unit": false,
              "output": false,
              "defenseType": false,
              "effect": false
            }
          }
        }
      ]
    }
  }
}
