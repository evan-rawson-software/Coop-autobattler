{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Events and run modifiers",
  "description": "Event definitions and the run modifiers a Shrine offers (W2-3). An event's type names a handler in the session package; params are read only by that handler. Modifier effects are copied into the team state when taken. All values are placeholders to tune.",
  "type": "object",
  "required": ["offerCount", "events", "modifiers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "offerCount": {
      "description": "How many events are offered at each event step.",
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^evt_[a-z0-9_]+$" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "weight": { "type": "integer", "minimum": 1 },
          "params": {
            "description": "Numbers and strings read by the event type's handler.",
            "type": "object",
            "additionalProperties": {
              "oneOf": [{ "type": "integer" }, { "type": "string" }]
            }
          }
        }
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stackable", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^mod_[a-z0-9_]+$" },
          "stackable": { "type": "boolean" },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/effect" }
          }
        }
      }
    }
  },
  "$defs": {
    "effect": {
      "description": "One effect of a modifier; the simulation applies percent bonuses in integers, rounded down.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "target", "percent"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "building_health_percent" },
            "target": {
              "enum": [
                "all",
                "wall",
                "gate",
                "turret",
                "source",
                "route",
                "unit_producer",
                "economy"
              ]
            },
            "percent": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "percent"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "core_health_percent",
                "unit_strength_percent",
                "turret_damage_percent"
              ]
            },
            "percent": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      ]
    }
  }
}
