{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presentation.schema.json",
  "title": "Presentation text (one language)",
  "description": "Display text keyed by content ID, plus the sentence templates the screens fill in. No rules. Texts may mention a resource as {res_x}, which is replaced by its configured name. Cross-file checks require exactly one entry per building, unit, terrain feature, archetype, event type and run modifier, and that every template placeholder is a slot its template allows.",
  "type": "object",
  "required": [
    "buildings",
    "units",
    "terrain",
    "archetypes",
    "events",
    "modifiers",
    "templates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "buildings": {
      "$ref": "#/$defs/groupBuildings"
    },
    "units": {
      "$ref": "#/$defs/groupUnits"
    },
    "terrain": {
      "$ref": "#/$defs/groupTerrain"
    },
    "archetypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^arch_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/archetypeEntry"
      }
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/eventEntry"
      }
    },
    "modifiers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^mod_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/modifierEntry"
      }
    },
    "templates": {
      "type": "object",
      "required": ["effects", "kinds", "needs"],
      "additionalProperties": false,
      "properties": {
        "effects": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "needs": {
          "type": "object",
          "required": ["nothing", "any"],
          "additionalProperties": false,
          "properties": {
            "nothing": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "any": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "groupBuildings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^bld_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "groupUnits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^unit_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "groupTerrain": {
      "type": "object",
      "propertyNames": {
        "pattern": "^ter_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "entry": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "archetypeEntry": {
      "type": "object",
      "required": ["name", "description", "tests"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tests": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "eventEntry": {
      "type": "object",
      "required": ["name", "icon", "flavour"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "flavour": {
          "type": "string"
        }
      }
    },
    "modifierEntry": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
