      "type": "object",
      "propertyNames": {
        "pattern": "^bld_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "groupUnits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^unit_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "groupTerrain": {
      "type": "object",
      "propertyNames": {
        "pattern": "^ter_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "entry": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "archetypeEntry": {
      "type": "object",
      "required": ["name", "description", "tests"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tests": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "eventEntry": {
      "type": "object",
      "required": ["name", "icon", "flavour"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "flavour": {
          "type": "string"
        }
      }
    },
    "modifierEntry": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
