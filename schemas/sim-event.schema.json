{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sim-event.schema.json",
  "title": "Simulation event",
  "description": "One entry of a battle event log. Plain JSON: integers and strings only. Later issues add event types by adding branches to oneOf. Movement along conduits is deliberately not logged. The flow events (produced, delivered, lost, stalled) appear in two forms: in a single-board flow log without `side`, and in an arena log (two boards) with `side`, the board's side (0 or 1); there, delivered names the input side `input` because `side` is the board. Unit and building events use arena coordinates.",
  "oneOf": [
    {
      "title": "produced",
      "description": "A source emitted one item (into a conduit, onward, or into a dead end).",
      "type": "object",
      "required": ["tick", "type", "building", "resource"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "produced"
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "resource": {
          "type": "string"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    {
      "title": "delivered",
      "description": "A consumer input buffer accepted one item.",
      "type": "object",
      "required": ["tick", "type", "building", "side", "resource"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "delivered"
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "enum": ["north", "east", "south", "west"]
        },
        "resource": {
          "type": "string"
        }
      }
    },
    {
      "title": "lost",
      "description": "An item reached a dead end at this building and was discarded.",
      "type": "object",
      "required": ["tick", "type", "building", "resource"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "lost"
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "resource": {
          "type": "string"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    {
      "title": "stalled",
      "description": "A source could not place its item; recorded only on the tick it first stalls.",
      "type": "object",
      "required": ["tick", "type", "building"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "stalled"
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    {
      "title": "delivered (arena log)",
      "description": "A consumer input buffer accepted one item, on the board of `side`; `input` is the input side of the building.",
      "type": "object",
      "required": ["tick", "type", "side", "building", "input", "resource"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "delivered"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "enum": ["north", "east", "south", "west"]
        },
        "resource": {
          "type": "string"
        }
      }
    },
    {
      "title": "unit_spawned",
      "description": "A unit appeared (a producer made it, or a scheduled-wave unit found room): its centre in arena sub-cell units (240 per cell). There is no movement event: positions come from re-stepping the simulation.",
      "type": "object",
      "required": [
        "tick",
        "type",
        "unit",
        "side",
        "def",
        "px",
        "py",
        "building",
        "owner",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unit_spawned"
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "def": {
          "type": "string"
        },
        "building": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "px": {
          "type": "integer",
          "minimum": 0,
          "description": "Centre, arena sub-cell units (CELL_UNITS = 240 per cell)."
        },
        "py": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "type": "integer",
          "minimum": 0,
          "description": "The unit's owner: the producing building's owner, or for a wave unit the plot of the column it enters on."
        },
        "target": {
          "type": "integer",
          "minimum": -1,
          "description": "The player index of the enemy Core the unit heads for, or -1 when none stands."
        }
      }
    },
    {
      "title": "burst_released",
      "description": "A boss Core's health fell to a burst threshold (MM-9d): the units it releases enter from the next tick on. One event per Core and threshold, highest threshold first, recorded in step 4 after the damage.",
      "type": "object",
      "required": ["tick", "type", "side", "core", "thresholdPercent", "units"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "burst_released" },
        "side": { "type": "integer", "minimum": 0, "maximum": 1 },
        "core": {
          "type": "integer",
          "minimum": 0,
          "description": "The player index of the Core that released the burst."
        },
        "thresholdPercent": { "type": "integer", "minimum": 1, "maximum": 99 },
        "units": {
          "type": "array",
          "description": "The units released, in composition order.",
          "items": {
            "type": "object",
            "required": ["unit", "count"],
            "additionalProperties": false,
            "properties": {
              "unit": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "tick": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "pylon_destroyed",
      "description": "A boss pylon (MM-9d) was destroyed, recorded in step 6 right after its building_destroyed. `standing` is how many pylons of that Core remain.",
      "type": "object",
      "required": ["tick", "type", "side", "building", "core", "standing"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "pylon_destroyed" },
        "side": { "type": "integer", "minimum": 0, "maximum": 1 },
        "building": { "type": "integer", "minimum": 1 },
        "core": {
          "type": "integer",
          "minimum": 0,
          "description": "The player index of the Core it shielded."
        },
        "standing": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "core_shield_down",
      "description": "The last pylon of a boss Core (MM-9d) was destroyed: the Core takes damage from the next tick on. Recorded right after that pylon_destroyed.",
      "type": "object",
      "required": ["tick", "type", "side", "core"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "core_shield_down" },
        "side": { "type": "integer", "minimum": 0, "maximum": 1 },
        "core": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "core_hit_blocked",
      "description": "A unit's hit on a boss Core that a pylon shields (MM-9d) did nothing, recorded in step 4 right after the unit_attacked of the same hit. The shipped targeting never aims at a shielded Core, so this appears only if a unit's hit lands on one anyway.",
      "type": "object",
      "required": ["tick", "type", "unit", "side", "core", "damage"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "core_hit_blocked" },
        "unit": { "type": "integer", "minimum": 1 },
        "side": { "type": "integer", "minimum": 0, "maximum": 1 },
        "core": { "type": "integer", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": 0 }
      }
    },
    {
      "title": "unit_retargeted",
      "description": "A unit's target Core was destroyed and it chose a new one (the nearest remaining enemy Core), recorded after the destruction events of the tick.",
      "type": "object",
      "required": ["tick", "type", "unit", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unit_retargeted"
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "type": "integer",
          "minimum": -1,
          "description": "The player index of the new target Core, or -1 when no enemy Core stands."
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "unit_attacked",
      "description": "A unit attacked a unit, a building, or a Core, dealing `damage` (applied simultaneously with all other attacks of the tick).",
      "type": "object",
      "required": ["tick", "type", "unit", "target", "damage"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unit_attacked"
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "pool": {
          "description": "Only when the target is a Core of a side with linked Cores (MM-9d): the shared pool's health at the start of the tick, before the tick's damage.",
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "unit"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "unit"
                },
                "unit": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": ["kind", "side", "building"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "building"
                },
                "side": {
                  "type": "integer",
                  "enum": [0, 1]
                },
                "building": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": ["kind", "side", "core"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "core"
                },
                "side": {
                  "type": "integer",
                  "enum": [0, 1]
                },
                "core": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "splash",
      "description": "A unit with `splash` attacked a unit (its `unit_attacked` event comes first): `x`, `y` are the primary target's centre in sub-cell units, `targets` the other opposing units hit within the splash radius, in unit ID order, each with the damage it took after its own armor (possibly empty). The damage joins the tick's pending damage like any attack.",
      "type": "object",
      "required": ["tick", "type", "attacker", "x", "y", "targets"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "splash"
        },
        "attacker": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit", "damage"],
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "integer",
                "minimum": 1
              },
              "damage": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "title": "turret_fired",
      "description": "A turret fired at an enemy unit standing on the turret owner's own side of the front edge, adding `damage` to that unit's pending damage (resolved simultaneously with unit attacks). `side` is the turret owner's side, `building` the turret's instance ID, `unit` the target.",
      "type": "object",
      "required": ["tick", "type", "side", "building", "unit", "damage"],
      "additionalProperties": false,
      "properties": {
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "turret_fired"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "title": "guard_spawned",
      "description": "A neutral guard (CB-8e) was placed at its point of interest at tick 0, before the first tick, in point id order. Its centre is in arena sub-cell units (240 per cell). Guards have side 2 and take the first unit IDs; they are not counted as spawned units of a side.",
      "type": "object",
      "required": ["tick", "type", "unit", "point", "def", "px", "py"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "guard_spawned"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "point": {
          "type": "integer",
          "minimum": 0,
          "description": "The id of the point of interest the guard guards."
        },
        "def": {
          "type": "string"
        },
        "px": {
          "type": "integer",
          "minimum": 0,
          "description": "Centre, arena sub-cell units (CELL_UNITS = 240 per cell)."
        },
        "py": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "point_capture_started",
      "description": "A side's units began capturing a point of interest (CB-8f): the point's progressSide became side with progress 0, because exactly one side had units in capture range, no guard of the point lived and the side did not hold it. Recorded in the capture step at the end of the tick, points in id order.",
      "type": "object",
      "required": ["tick", "type", "point", "side"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "point_capture_started"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "point": {
          "type": "integer",
          "minimum": 0,
          "description": "The id of the point of interest."
        },
        "side": {
          "enum": [0, 1]
        }
      }
    },
    {
      "title": "point_captured",
      "description": "A side took a point of interest (CB-8f): its capture progress reached captureTicks. previous is the side that held the point before (-1 for nobody).",
      "type": "object",
      "required": ["tick", "type", "point", "side", "previous"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "point_captured"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "point": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [0, 1]
        },
        "previous": {
          "enum": [-1, 0, 1]
        }
      }
    },
    {
      "title": "unit_died",
      "description": "A unit's health reached 0 or less and it was removed. A neutral guard's death (CB-8e) carries side 2; the death of a unit of a side has no side.",
      "type": "object",
      "required": ["tick", "type", "unit"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "unit_died"
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "const": 2,
          "description": "Only for a neutral guard (CB-8e)."
        }
      }
    },
    {
      "title": "building_destroyed",
      "description": "A building's health reached 0; it and its attached conduits are removed.",
      "type": "object",
      "required": ["tick", "type", "side", "building"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "building_destroyed"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "conduit_destroyed",
      "description": "A conduit was removed because a building attached to it was destroyed.",
      "type": "object",
      "required": ["tick", "type", "side", "conduit"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conduit_destroyed"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "conduit": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "core_destroyed",
      "description": "One of a side's Cores (by player index) was destroyed; the battle ends when a side has none left.",
      "type": "object",
      "required": ["tick", "type", "side", "core"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "core_destroyed"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "core": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "ramp_step",
      "description": "An economy building completed one upgrade step (in-battle ramp).",
      "type": "object",
      "required": ["tick", "type", "side", "building", "effect", "steps"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ramp_step"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "building": {
          "type": "integer",
          "minimum": 1
        },
        "effect": {
          "enum": ["source_speed", "unit_strength"]
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "overload_started",
      "description": "Overload level 1 began (CB-12).",
      "type": "object",
      "required": ["tick", "type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "overload_started"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "overload_level",
      "description": "The Overload level rose to `level` (also emitted for level 1).",
      "type": "object",
      "required": ["tick", "type", "level"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "overload_level"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "overload_core_damage",
      "description": "Overload Core decay hit one of a side's living Cores (by player index).",
      "type": "object",
      "required": ["tick", "type", "side", "core", "damage"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "overload_core_damage"
        },
        "side": {
          "type": "integer",
          "enum": [0, 1]
        },
        "core": {
          "type": "integer",
          "minimum": 0
        },
        "damage": {
          "type": "integer",
          "minimum": 1
        },
        "pool": {
          "description": "Only for a side with linked Cores (MM-9d): the decay is taken from the shared pool once, so this is the only decay event of the side that beat, naming its lowest living Core; `pool` is the pool's health at the start of the tick.",
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "zone_revealed",
      "description": "The neutral zone between the boards, revealed at tick 0 of a battle (W1-8). The zone has the format of neutral-zone.schema.json; its coordinates are zone-local (y = 0 touches side 0's front edge).",
      "type": "object",
      "required": ["tick", "type", "zone"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "zone_revealed"
        },
        "zone": {
          "type": "object",
          "required": ["width", "depth", "features", "pointsOfInterest"],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "feature"],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "feature": {
                    "type": "string",
                    "pattern": "^ter_[a-z0-9_]+$"
                  }
                }
              }
            },
            "pointsOfInterest": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "band", "x", "y", "buff"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "integer", "minimum": 0 },
                  "band": { "type": "integer", "minimum": 0 },
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "buff": { "type": "string", "pattern": "^poi_[a-z0-9_]+$" }
                }
              }
            }
          }
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "battle_ended",
      "description": "The last event of a battle: the winner (0 = the party, 1 = the opponent) and why. Its tick is the last tick that ran.",
      "type": "object",
      "required": ["tick", "type", "winner", "reason"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "battle_ended"
        },
        "winner": {
          "type": "integer",
          "enum": [0, 1]
        },
        "reason": {
          "enum": [
            "core_destroyed",
            "tiebreak_overkill",
            "tiebreak_building_damage",
            "tiebreak_kills",
            "tiebreak_attacker",
            "time_limit"
          ]
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
