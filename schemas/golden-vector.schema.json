{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/golden-vector.schema.json",
  "title": "Golden vector file",
  "description": "A golden/*.json file is an array of golden vectors. Language-neutral: only null, booleans, integers, strings, arrays and objects.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/vector" },
  "definitions": {
    "json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/definitions/json" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/json" }
        }
      ]
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "kind": {
          "type": "string",
          "description": "Name of the simulation function this vector exercises.",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": { "type": "string" },
        "input": { "$ref": "#/definitions/json" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "result": { "$ref": "#/definitions/json" },
            "checkpoints": {
              "type": "array",
              "description": "Intermediate states of a battle vector with a checkpointEvery input.",
              "items": { "$ref": "#/definitions/json" }
            },
            "eventLogHash": {
              "type": "string",
              "description": "FNV-1a 32 of the canonical JSON of the event log, 8 lowercase hex digits.",
              "pattern": "^[0-9a-f]{8}$"
            }
          }
        }
      }
    }
  }
}
