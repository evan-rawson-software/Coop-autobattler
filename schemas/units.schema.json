{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "units.schema.json",
  "title": "Unit rules",
  "description": "Combat numbers for units (CB-13..CB-15). All integers; times are in ticks. Names live in the presentation file.",
  "type": "object",
  "required": ["units"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "required": [
        "id",
        "health",
        "damage",
        "attackCooldownTicks",
        "rangeCells",
        "moveCooldownTicks",
        "targeting"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^unit_[a-z0-9_]+$" },
        "health": { "type": "integer", "minimum": 1 },
        "damage": { "type": "integer", "minimum": 0 },
        "attackCooldownTicks": { "type": "integer", "minimum": 1 },
        "rangeCells": {
          "description": "0 means melee (adjacent).",
          "type": "integer",
          "minimum": 0
        },
        "moveCooldownTicks": {
          "description": "Ticks per cell moved.",
          "type": "integer",
          "minimum": 1
        },
        "targeting": {
          "description": "core: head for the enemy Core, attack what blocks. infrastructure: prefer sources and route buildings. defenses: prefer walls and turrets (CB-15).",
          "enum": ["core", "infrastructure", "defenses"]
        }
      }
    }
  }
}
