{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economy.schema.json",
  "title": "Economy configuration",
  "description": "Gold, starting kit, shop size, re-roll and sell rules, and offer odds (W2-2). All values are placeholders to tune.",
  "type": "object",
  "required": [
    "startingGold",
    "startingKit",
    "baseIncomePerShop",
    "shopOfferCount",
    "rerollCost",
    "sellRefundPercent",
    "offerWeights",
    "tierOdds"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "startingGold": {
      "description": "Gold each player starts the run with.",
      "type": "integer",
      "minimum": 0
    },
    "startingKit": {
      "description": "Buildings given to each player at the start of the run.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["def", "tier", "count"],
        "additionalProperties": false,
        "properties": {
          "def": { "type": "string", "pattern": "^bld_[a-z0-9_]+$" },
          "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "baseIncomePerShop": {
      "description": "Gold each player receives on entering each shop step.",
      "type": "integer",
      "minimum": 0
    },
    "shopOfferCount": {
      "description": "Offers in each player's shop.",
      "type": "integer",
      "minimum": 1
    },
    "rerollCost": {
      "description": "Gold a re-roll costs.",
      "type": "integer",
      "minimum": 0
    },
    "sellRefundPercent": {
      "description": "Percent of the building tier's price returned when selling, rounded down.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "offerWeights": {
      "description": "How likely each building is to be offered. Buildings not listed are never offered.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["def", "weight"],
        "additionalProperties": false,
        "properties": {
          "def": { "type": "string", "pattern": "^bld_[a-z0-9_]+$" },
          "weight": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tierOdds": {
      "description": "Tier weights by round. The row with the largest fromRound not above the current round applies. Sorted by fromRound, starting at 1.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fromRound", "weights"],
        "additionalProperties": false,
        "properties": {
          "fromRound": { "type": "integer", "minimum": 1 },
          "weights": {
            "description": "Weights for tiers 1, 2 and 3.",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
