{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-state.schema.json",
  "title": "Team state",
  "description": "The party's whole state for combat (W1-2, W1-3): the map, one Core position per player, every building and every conduit. Arrays are sorted by ascending id. A Core is not an entry in buildings or stash. Instance IDs of buildings and conduits are drawn from one counter (nextId). Placement and conduit legality are checked by the validator, not by this schema.",
  "type": "object",
  "required": ["map", "cores", "buildings", "stash", "nextId", "conduits"],
  "additionalProperties": false,
  "properties": {
    "map": {
      "$ref": "map.schema.json"
    },
    "cores": {
      "description": "One entry per player (map.partySize entries): player p's Core as its lowest-x, lowest-y cell, or null before it is placed. The footprint lies wholly in plot p.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "def", "tier", "x", "y", "rotation", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "def": {
            "type": "string",
            "pattern": "^bld_[a-z0-9_]+$"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "rotation": {
            "enum": [0, 90, 180, 270]
          },
          "owner": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "stash": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "def", "tier", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "def": {
            "type": "string",
            "pattern": "^bld_[a-z0-9_]+$"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "owner": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "nextId": {
      "type": "integer",
      "minimum": 1
    },
    "modifiers": {
      "description": "Run modifiers taken so far (W2-3, EC-8), in the order taken, each with the effects it had when taken. Omitted when there are none.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mod_[a-z0-9_]+$"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/effect"
            }
          }
        }
      }
    },
    "conduits": {
      "description": "Conduits, sorted by ascending id. Each runs from a side of one placed building to a side of another building of the same owner; cells is the ordered path from the cell just outside the from side to the cell just outside the to side, empty for a direct connection.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "from", "to", "cells"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "owner": {
            "description": "The player who drew the conduit (PP-1). It joins two buildings of this player and lies in this player's plot.",
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "$ref": "#/$defs/conduitEnd"
          },
          "to": {
            "$ref": "#/$defs/conduitEnd"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "conduitEnd": {
      "type": "object",
      "required": ["building", "side"],
      "additionalProperties": false,
      "properties": {
        "building": {
          "description": "Instance ID of a placed building.",
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "enum": ["north", "east", "south", "west"]
        }
      }
    },
    "effect": {
      "description": "One effect of a modifier; the simulation applies percent bonuses in integers, rounded down.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "target", "percent"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "building_health_percent"
            },
            "target": {
              "enum": [
                "all",
                "wall",
                "gate",
                "turret",
                "source",
                "route",
                "unit_producer",
                "economy"
              ]
            },
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "percent"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "core_health_percent",
                "unit_strength_percent",
                "turret_damage_percent"
              ]
            },
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      ]
    }
  }
}
