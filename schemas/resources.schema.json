{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resources.schema.json",
  "title": "Resource configuration",
  "description": "Every resource in the game, keyed by a stable neutral ID. Display names live only here (TA-27a).",
  "type": "object",
  "required": ["resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^res_[a-z0-9_]+$"
    },
    "resource": {
      "type": "object",
      "required": ["id", "name", "rarity"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/resourceId" },
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rarity": {
          "description": "Hint for map generation (CB-5c).",
          "enum": ["common", "rare"]
        },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "type": "string", "minLength": 1 },
        "refinedFrom": {
          "description": "Refined resources only: the one or two resources this is made from. Not used yet.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/resourceId" }
        }
      }
    }
  }
}
