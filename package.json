{
  "name": "game-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "preview": "pnpm --filter @game/web exec vite preview",
    "validate:content": "pnpm --filter @game/tools run validate:content",
    "golden:update": "pnpm --filter @game/golden run update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "pnpm --filter @game/web run build:debug && node packages/web/scripts/smoke.mjs",
    "sim": "tsx packages/tools/src/sim/cli.ts",
    "art:build": "pnpm --filter @game/art run generate",
    "ghosts:update": "tsx packages/tools/src/sim/cli.ts ghosts",
    "boards:export": "tsx packages/tools/src/sim/export-boards.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
